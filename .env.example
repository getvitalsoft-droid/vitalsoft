# ─── Sistema de Referidos de Clientes ─────────────────────────────────────
# (No requiere variables adicionales — usa las mismas de Supabase y Resend)

# ─── Sistema de Reseñas Externas ──────────────────────────────────────────
# Añadir la URL de tu plataforma de reseñas. Si no se configura, no se envían emails.
# Ejemplos:
# NEXT_PUBLIC_REVIEW_URL=https://www.trustpilot.com/review/vitalsoft.pro
# NEXT_PUBLIC_REVIEW_URL=https://senja.io/p/vitalsoft/r/XXXXXX
NEXT_PUBLIC_REVIEW_URL=

# ─── Stripe Elements (checkout embebido) ──────────────────────────────────
# Clave pública de Stripe — va en el cliente (NEXT_PUBLIC)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── Portal de cliente ────────────────────────────────────────────────────
# Usa CRON_SECRET como firma de tokens (ya debe estar configurado)
# No se necesita variable adicional
