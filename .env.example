# ─────────────────────────────────────────────────────────────────────────────
# VitalSoft — Environment Variables
# Copy this file to .env.local and fill in your actual values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Stripe — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stripe Payment Links — create these in your Stripe dashboard
# Dashboard → Payment Links → Create link (set as recurring/subscription)
NEXT_PUBLIC_STRIPE_STARTER_LINK=https://buy.stripe.com/XXXX
NEXT_PUBLIC_STRIPE_GROWTH_LINK=https://buy.stripe.com/XXXX
NEXT_PUBLIC_STRIPE_SCALE_LINK=https://buy.stripe.com/XXXX
NEXT_PUBLIC_STRIPE_PRO_LINK=https://buy.stripe.com/XXXX
NEXT_PUBLIC_STRIPE_CUSTOM_LINK=https://buy.stripe.com/XXXX

# Stripe Webhook Secret — from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Site URL (used for Stripe redirect_url)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Email service for contact form notifications (e.g. Resend, SendGrid)
# RESEND_API_KEY=re_XXXXXXXXXXXX
# NOTIFICATION_EMAIL=hello@vitalsoft.com

